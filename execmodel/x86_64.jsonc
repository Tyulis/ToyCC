{
    "locations": ["constant",
                  "a", "b", "c", "d", "si", "di", "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15",
                  "mm0", "mm1", "mm2", "mm3", "mm4", "mm5", "mm6", "mm7", "mm8", "mm9", "mm10", "mm11", "mm12", "mm13", "mm14", "mm15",
                  "stack", "memory",
                  "sp", "bp"],

    "category_locations": {"constant": ["constant"], "label": ["constant"], "dereference": ["memory"],
                           "variable": ["a", "b", "c", "d", "si", "di", "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15",
                                        "mm0", "mm1", "mm2", "mm3", "mm4", "mm5", "mm6", "mm7", "mm8", "mm9", "mm10", "mm11", "mm12", "mm13", "mm14", "mm15",
                                        "stack", "memory"]},

    "register_locations": {"al": "a", "ax": "a", "eax": "a", "rax": "a",
                           "dl": "d", "dx": "d", "edx": "d", "rdx": "d"},

    "register_sizes":     {"al": 1, "ax": 2, "eax": 4, "rax": 8,
                           "dl": 1, "dx": 2, "edx": 4, "rdx": 8},

    "no_output":         ["constant", "sp", "bp"],
    "no_allocation":     ["constant", "stack", "memory"],
    "banked_locations":  ["constant", "stack", "memory"],  // Non-unique locations

    "operand_types": {
        "0"            : {"category": "constant", "type": ["BOOL", "INTEGER"], "value":  0},
        "-1"           : {"category": "constant", "type": "INTEGER", "value": -1},
        "constint"     : {"category": "constant", "type": "INTEGER"},
        "var"          : {"category": "variable"},
        "deref"        : {"category": "dereference"},
        "int"          : {"type": "INTEGER"},
        "sint"         : {"type": "INTEGER", "signed": true},
        "uint"         : {"type": "INTEGER", "signed": false},
        "bool"         : {"type": "BOOL"},
        "tempbool"     : {"type": "BOOL", "storage": "INTERMEDIATE"},
        "r"            : {"location": ["a", "b", "c", "d", "si", "di", "bp", "sp", "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15"]},  // Any register
        "rd"           : {"location": ["a", "b", "c", "d", "si", "di",             "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15"]},  // Any data register (stack pointers excluded)
        "m"            : {"union": [{"category": "dereference"}, {"location": ["stack", "memory"]}]},
        "rm"           : {"anyof": ["r", "m"]},
        "rdm"          : {"anyof": ["rd", "m"]},
        "label"        : {"category": "label"},

        "1"            : {"category": "constant", "type": ["BOOL", "INTEGER"], "value": 1},
        "3"            : {"category": "constant", "type": "INTEGER", "value": 3},
        "a"            : {"location": "a"},
        "al"           : {"location": "a", "size": 1},
        "ax"           : {"location": "a", "size": 2},
        "eax"          : {"location": "a", "size": 4},
        "rax"          : {"location": "a", "size": 8},
        "cl"           : {"location": "c", "size": 1},
        "xmm0"         : {"location": "mm0"},
        "rel8"         : {"category": "label"},
        "rel32"        : {"category": "label"},
        "rel32m"       : {"category": "label"},
        "imm4"         : {"category": "constant", "type": ["BOOL", "INTEGER"], "value_bits": 4},
        "imm8"         : {"category": "constant", "type": ["BOOL", "INTEGER"], "size": 1},
        "imm16"        : {"category": "constant", "type": ["BOOL", "INTEGER"], "size": 2},
        "imm32"        : {"category": "constant", "type": ["BOOL", "INTEGER"], "size": 4},
        "imm64"        : {"category": "constant", "type": ["BOOL", "INTEGER"], "size": 8},
        "r8"           : {"anyof": "r", "size": 1},
        "r16"          : {"anyof": "r", "size": 2},
        "r32"          : {"anyof": "r", "size": 4},
        "r64"          : {"anyof": "r", "size": 8},
        "rd8"          : {"anyof": "rd", "size": 1},
        "rd16"         : {"anyof": "rd", "size": 2},
        "rd32"         : {"anyof": "rd", "size": 4},
        "rd64"         : {"anyof": "rd", "size": 8},
        "mm"           : false,
        "xmm"          : false,
        "xmm{k}"       : false,
        "xmm{k}{z}"    : false,
        "ymm"          : false,
        "ymm{k}"       : false,
        "ymm{k}{z}"    : false,
        "zmm"          : false,
        "zmm{k}"       : false,
        "zmm{k}{z}"    : false,
        "k"            : false,
        "k{k}"         : false,
        "m8"           : {"anyof": "m", "size": 1},
        "m16"          : {"anyof": "m", "size": 2},
        "m16{k}"       : false,
        "m32"          : {"anyof": "m", "size": 4},
        "m32{k}"       : false,
        "m64"          : {"anyof": "m", "size": 8},
        "m64{k}"       : false,
        "m80"          : false,
        "m128"         : false,
        "m128{k}"      : false,
        "m256"         : false,
        "m256{k}"      : false,
        "m512"         : false,
        "m512{k}"      : false,
        "moffs32"      : false,
        "moffs64"      : false,
        "m32/m16bcst"  : false,
        "m64/m16bcst"  : false,
        "m64/m32bcst"  : false,
        "m128/m16bcst" : false,
        "m128/m32bcst" : false,
        "m128/m64bcst" : false,
        "m256/m16bcst" : false,
        "m256/m32bcst" : false,
        "m256/m64bcst" : false,
        "m512/m16bcst" : false,
        "m512/m32bcst" : false,
        "m512/m64bcst" : false,
        "vm32x"        : false,
        "vm32x{k}"     : false,
        "vm32y"        : false,
        "vm32y{k}"     : false,
        "vm32z"        : false,
        "vm32z{k}"     : false,
        "vm64x"        : false,
        "vm64x{k}"     : false,
        "vm64y"        : false,
        "vm64y{k}"     : false,
        "vm64z"        : false,
        "vm64z{k}"     : false,
        "{sae}"        : false,
        "{er}"         : false
    },

    "transfers": [{"target": "MOV"}],

    "ir": {
        "MARKER":         {"input": [], "output": true,                 "translate": false},
        "BLOCK":          {"input": [], "output": false, "block": true, "translate": false},
        "FUNCTION":       {"input": [], "output": false, "block": true, "translate": false},

        "CALL":           {"matcher": {"header": "arch/x86_64/custom_matchers.h", "function": "match_call"},
                           "emitter": {"header": "arch/x86_64/custom_targets.h",  "function": "emit_call"}},

        "JUMP":           {"input": ["target"],              "output": false},
        "JUMP_IF_TRUE":   {"input": ["target", "predicate"], "output": false},
        "JUMP_IF_FALSE":  {"input": ["target", "predicate"], "output": false},
        "RETURN_VAL":     {"input": ["value"],               "output": false},
        "RETURN":         {"input": [],                      "output": false},

        "COPY":           {"input": ["source"],              "output": true},
        "PLUS":           {"input": ["operand"],             "output": true},
        "MINUS":          {"input": ["operand"],             "output": true},
        "ADDRESSOF":      {"input": ["operand"],             "output": true},
        "FLOAT_TO_FLOAT": {"input": ["operand"],             "output": true},
        "INT_TO_FLOAT":   {"input": ["operand"],             "output": true},
        "FLOAT_TO_INT":   {"input": ["operand"],             "output": true},
        "SIGN_EXTEND":    {"input": ["operand"],             "output": true},

        "MUL":            {"input": ["left", "right"],       "output": true, "commutative": true},
        "DIV":            {"input": ["left", "right"],       "output": true},
        "MOD":            {"input": ["left", "right"],       "output": true},
        "ADD":            {"input": ["left", "right"],       "output": true, "commutative": true},
        "SUB":            {"input": ["left", "right"],       "output": true},
        "LT":             {"input": ["left", "right"],       "output": true},
        "LE":             {"input": ["left", "right"],       "output": true},
        "GE":             {"input": ["left", "right"],       "output": true},
        "GT":             {"input": ["left", "right"],       "output": true},
        "EQ":             {"input": ["left", "right"],       "output": true, "commutative": true},
        "NE":             {"input": ["left", "right"],       "output": true, "commutative": true},
        "BITWISE_AND":    {"input": ["left", "right"],       "output": true, "commutative": true},
        "BITWISE_XOR":    {"input": ["left", "right"],       "output": true, "commutative": true},
        "BITWISE_OR":     {"input": ["left", "right"],       "output": true, "commutative": true},
        "LSHIFT":         {"input": ["left", "right"],       "output": true},
        "RSHIFT":         {"input": ["left", "right"],       "output": true},
        "LOGICAL_AND":    {"input": ["left", "right"],       "output": true, "commutative": true},
        "LOGICAL_OR":     {"input": ["left", "right"],       "output": true, "commutative": true}
    },

    "translations": [
        // -------- ADD
        {"ir": {"tag": "ADD", "left": "int",  "right":  "1"},  "target": {"instruction": "INC", "input": ["left"]}},
        {"ir": {"tag": "ADD", "left": "int",  "right": "-1"},  "target": {"instruction": "DEC", "input": ["left"]}},
        {"ir": {"tag": "ADD"},                                 "target": {"instruction": "ADD"}},

        // -------- SUB
        {"ir": {"tag": "SUB", "left": "int",  "right":  "1"}, "target": {"instruction": "DEC", "input": ["left"]}},
        {"ir": {"tag": "SUB", "left": "int",  "right": "-1"}, "target": {"instruction": "INC", "input": ["left"]}},
        {"ir": {"tag": "SUB"},                                "target": {"instruction": "SUB"}},

        // -------- MUL
        // Signed integer multiplication
        {"ir"    : {"tag": "MUL", "left": "sint", "right": "sint"}, "allocate": {"mulhi": {"anyof": "sint"}},
         "target": {"instruction": "IMUL", "input": ["right"], "implicit": {"a": ["left", "output"], "d": "$mulhi"}}},
        {"ir"    : {"tag": "MUL", "left": "sint", "right": "sint"}, "target": {"instruction": "IMUL", "input": ["left", "right"]}},
        {"ir"    : {"tag": "MUL", "left": "sint", "right": "sint", "output": "sint"}, "target": {"instruction": "IMUL", "input": ["left", "right"], "output": "output"}},

        // Unsigned integer multiplication
        {"ir"    : {"tag": "MUL", "left": "uint", "right": "uint"}, "allocate": {"mulhi": {"anyof": "uint"}},
         "target": {"instruction": "MUL", "input": ["right"], "implicit": {"a": ["left", "output"], "d": "$mulhi"}}},

        // -------- DIV
        // Signed integer division
        {"ir"    : {"tag": "DIV", "left": "sint", "right": "sint"}, "allocate": {"remainder": {"anyof": "sint"}},
         "target": [{"instruction": "XOR", "input": ["$remainder", "$remainder"]},  // D makes up the upper part of the dividend, clear it
                    {"instruction": "IDIV", "input": ["right"], "implicit": {"a": ["left", "output"], "d": "$remainder"}}]},

        // -------- MOD
        // Signed integer division
        {"ir"    : {"tag": "MOD", "left": "sint", "right": "sint"},
         "target": [{"instruction": "XOR", "input": ["$0.output", "$0.output"]},  // D makes up the upper part of the dividend, clear it
                    {"instruction": "IDIV", "input": ["right"], "implicit": {"a": "left", "d": "output"}}]},

        // -------- BITWISE_AND
        {"ir": {"tag": "BITWISE_AND"}, "target": {"instruction": "AND"}},

        // -------- BITWISE_OR
        {"ir": {"tag": "BITWISE_OR"}, "target": {"instruction": "OR"}},

        // -------- BITWISE_XOR
        {"ir": {"tag": "BITWISE_XOR"}, "target": {"instruction": "XOR"}},

        // -------- EQ
        {"ir":     [{"tag": "EQ", "right": "0"}],
         "target": [{"instruction": "TEST", "input": ["$0.left", "$0.left"]},
                    {"instruction": "SETZ", "output": "$0.output"}]},
        {"ir":     [{"tag": "EQ"}],
         "target": [{"instruction": "CMP",  "input": ["$0.left", "$0.right"]},
                    {"instruction": "SETE", "output": "$0.output"}]},

        // -------- NE
        {"ir":     [{"tag": "NE", "right": "0"}],
         "target": [{"instruction": "TEST",  "input": ["$0.left", "$0.left"]},
                    {"instruction": "SETNZ", "output": "$0.output"}]},
        {"ir":     [{"tag": "NE"}],
         "target": [{"instruction": "CMP",   "input": ["$0.left", "$0.right"]},
                    {"instruction": "SETNE", "output": "$0.output"}]},

        // -------- LT
        {"ir":     [{"tag": "LT"}],
         "target": [{"instruction": "CMP",  "input": ["$0.left", "$0.right"]},
                    {"instruction": "SETL", "output": "$0.output"}]},

        // -------- LE
        {"ir":     [{"tag": "LE"}],
         "target": [{"instruction": "CMP",   "input": ["$0.left", "$0.right"]},
                    {"instruction": "SETLE", "output": "$0.output"}]},

        // -------- GT
        {"ir":     [{"tag": "GT"}],
         "target": [{"instruction": "CMP",  "input": ["$0.left", "$0.right"]},
                    {"instruction": "SETG", "output": "$0.output"}]},

        // -------- GE
        {"ir":     [{"tag": "GE"}],
         "target": [{"instruction": "CMP",   "input": ["$0.left", "$0.right"]},
                    {"instruction": "SETGE", "output": "$0.output"}]},

        // -------- COPY
        // To clear a register, use `xor r, r`, that's a lot shorter than `mov 0, r`
        {"ir": {"tag": "COPY", "source": "0"}, "target": {"instruction": "XOR", "input": ["$0.output", "$0.output"]}},
        {"ir": {"tag": "COPY"}, "target": {"instruction": "MOV"}},

        // -------- MINUS
        {"ir": {"tag": "MINUS"}, "target": {"instruction": "NEG"}},

        // -------- ADDRESSOF
        // The input operand doesn't need to be in memory when the ADDRESSOF operation goes through, don't add a `location` constraint here
        // It will be flushed to memory whenever the produced pointer is dereferenced
        {"ir":     {"tag": "ADDRESSOF", "operand": {"anyof": ["var", "deref"]}, "output": "var"},
         "target": {"custom": true, "header": "arch/x86_64/custom_targets.h", "function": "emit_addressof"}},

        // -------- SIGN_EXTEND
        {"ir": {"tag": "SIGN_EXTEND"}, "target": {"instruction": "MOVSX"}},
        {"ir": {"tag": "SIGN_EXTEND"}, "target": {"instruction": "MOVSXD"}},

        // -------- Unconditional JUMP
        {"ir": {"tag": "JUMP", "target": "label"}, "target": {"instruction": "JMP"}},

        // -------- JUMP_IF_TRUE
        // Direct conversions to boolean -> (x == 0) is equivalent to (x & x) == 0, so emit `test x, x` when x is in registers, it's shorter
        {"ir"    : [{"tag": "EQ",           "right": "0", "output": "tempbool"},
                    {"tag": "JUMP_IF_TRUE", "target": "label", "predicate": "$0.output"}],
         "target": [{"instruction": "TEST", "input": ["$0.left", "$0.left"]},
                    {"instruction": "JZ",   "input": ["$1.target"]}]},
        {"ir"    : [{"tag": "NE",           "right": "0", "output": "tempbool"},
                    {"tag": "JUMP_IF_TRUE", "target": "label", "predicate": "$0.output"}],
         "target": [{"instruction": "TEST", "input": ["$0.left", "$0.left"]},
                    {"instruction": "JNZ",  "input": ["$1.target"]}]},

        // Actual comparisons
        {"ir"    : [{"tag": "EQ",           "left": "int", "right": "int", "output": "tempbool"},
                    {"tag": "JUMP_IF_TRUE", "target": "label", "predicate": "$0.output"}],
         "target": [{"instruction": "CMP", "input": ["$0.left", "$0.right"]},
                    {"instruction": "JE",  "input": ["$1.target"]}]},
        {"ir"    : [{"tag": "NE",           "left": "int", "right": "int", "output": "tempbool"},
                    {"tag": "JUMP_IF_TRUE", "target": "label", "predicate": "$0.output"}],
         "target": [{"instruction": "CMP", "input": ["$0.left", "$0.right"]},
                    {"instruction": "JNE",  "input": ["$1.target"]}]},
        {"ir"    : [{"tag": "GT",           "left": "int", "right": "int", "output": "tempbool"},
                    {"tag": "JUMP_IF_TRUE", "target": "label", "predicate": "$0.output"}],
         "target": [{"instruction": "CMP", "input": ["$0.left", "$0.right"]},
                    {"instruction": "JG",  "input": ["$1.target"]}]},
        {"ir"    : [{"tag": "GE",           "left": "int", "right": "int", "output": "tempbool"},
                    {"tag": "JUMP_IF_TRUE", "target": "label", "predicate": "$0.output"}],
         "target": [{"instruction": "CMP", "input": ["$0.left", "$0.right"]},
                    {"instruction": "JGE",  "input": ["$1.target"]}]},
        {"ir"    : [{"tag": "LT",           "left": "int", "right": "int", "output": "tempbool"},
                    {"tag": "JUMP_IF_TRUE", "target": "label", "predicate": "$0.output"}],
         "target": [{"instruction": "CMP", "input": ["$0.left", "$0.right"]},
                    {"instruction": "JL",  "input": ["$1.target"]}]},
        {"ir"    : [{"tag": "LE",           "left": "int", "right": "int", "output": "tempbool"},
                    {"tag": "JUMP_IF_TRUE", "target": "label", "predicate": "$0.output"}],
         "target": [{"instruction": "CMP", "input": ["$0.left", "$0.right"]},
                    {"instruction": "JLE",  "input": ["$1.target"]}]},

        // Actual boolean variable
        {"ir":     [{"tag": "JUMP_IF_TRUE"}],
         "target": [{"instruction": "TEST", "input": ["$0.predicate", "$0.predicate"]},
                    {"instruction": "JNZ",  "input": ["$0.target"]}]},

        // -------- JUMP_IF_FALSE
        // Direct conversions to boolean -> (x == 0) is equivalent to (x & x) == 0, so emit `test x, x` when x in in registers, it's shorter
        {"ir"    : [{"tag": "EQ",            "right": "0", "output": "tempbool"},
                    {"tag": "JUMP_IF_FALSE", "target": "label", "predicate": "$0.output"}],
         "target": [{"instruction": "TEST", "input": ["$0.left", "$0.left"]},
                    {"instruction": "JNZ",  "input": ["$1.target"]}]},
        {"ir"    : [{"tag": "NE",            "right": "0", "output": "tempbool"},
                    {"tag": "JUMP_IF_FALSE", "target": "label", "predicate": "$0.output"}],
         "target": [{"instruction": "TEST", "input": ["$0.left", "$0.left"]},
                    {"instruction": "JZ",  "input": ["$1.target"]}]},

        // Actual comparisons
        {"ir"    : [{"tag": "EQ",            "left": "int", "right": "int", "output": "tempbool"},
                    {"tag": "JUMP_IF_FALSE", "target": "label", "predicate": "$0.output"}],
         "target": [{"instruction": "CMP", "input": ["$0.left", "$0.right"]},
                    {"instruction": "JNE", "input": ["$1.target"]}]},
        {"ir"    : [{"tag": "NE",            "left": "int", "right": "int", "output": "tempbool"},
                    {"tag": "JUMP_IF_FALSE", "target": "label", "predicate": "$0.output"}],
         "target": [{"instruction": "CMP", "input": ["$0.left", "$0.right"]},
                    {"instruction": "JE",  "input": ["$1.target"]}]},
        {"ir"    : [{"tag": "GT",            "left": "int", "right": "int", "output": "tempbool"},
                    {"tag": "JUMP_IF_FALSE", "target": "label", "predicate": "$0.output"}],
         "target": [{"instruction": "CMP",  "input": ["$0.left", "$0.right"]},
                    {"instruction": "JNG",  "input": ["$1.target"]}]},
        {"ir"    : [{"tag": "GE",            "left": "int", "right": "int", "output": "tempbool"},
                    {"tag": "JUMP_IF_FALSE", "target": "label", "predicate": "$0.output"}],
         "target": [{"instruction": "CMP",  "input": ["$0.left", "$0.right"]},
                    {"instruction": "JNGE", "input": ["$1.target"]}]},
        {"ir"    : [{"tag": "LT",            "left": "int", "right": "int", "output": "tempbool"},
                    {"tag": "JUMP_IF_FALSE", "target": "label", "predicate": "$0.output"}],
         "target": [{"instruction": "CMP",  "input": ["$0.left", "$0.right"]},
                    {"instruction": "JNL",  "input": ["$1.target"]}]},
        {"ir"    : [{"tag": "LE",            "left": "int", "right": "int", "output": "tempbool"},
                    {"tag": "JUMP_IF_FALSE", "target": "label", "predicate": "$0.output"}],
         "target": [{"instruction": "CMP",  "input": ["$0.left", "$0.right"]},
                    {"instruction": "JNLE", "input": ["$1.target"]}]},

        // Actual boolean variable
        {"ir":     [{"tag": "JUMP_IF_FALSE"}],
         "target": [{"instruction": "TEST", "input": ["$0.predicate", "$0.predicate"]},
                    {"instruction": "JZ",   "input": ["$0.target"]}]},

        // -------- RETURN_VAL
        {"ir":       {"tag": "RETURN_VAL", "value": "a"},
         "target":   {"custom": true, "header": "arch/x86_64/custom_targets.h", "function": "emit_return"}},

        // -------- RETURN
        {"ir":       {"tag": "RETURN"},
         "target":   {"custom": true, "header": "arch/x86_64/custom_targets.h", "function": "emit_return"}},
    ]
}
