{
    "locations": ["constant",
                  "a", "b", "c", "d", "si", "di", "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15",
                  "mm0", "mm1", "mm2", "mm3", "mm4", "mm5", "mm6", "mm7", "mm8", "mm9", "mm10", "mm11", "mm12", "mm13", "mm14", "mm15",
                  "stack", "memory",
                  "sp", "bp"],

    "operand_types": {
        "-1"           : {"category": "constant", "type": "INTEGER", "value": -1},
        "constint"     : {"category": "constant", "type": "INTEGER"},
        "int"          : {"type": "INTEGER"},
        "bool"         : {"type": "BOOL"},
        "tempbool"     : {"type": "BOOL", "storage": "INTERMEDIATE"},
        "r"            : {"location": ["a", "b", "c", "d", "si", "di", "bp", "sp", "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15"]},
        "rd"           : {"location": ["a", "b", "c", "d", "si", "di",             "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15"]},
        "m"            : {"union": [{"category": "dereference"}, {"location": ["stack", "memory"]}]},
        "rm"           : {"anyof": ["r", "m"]},
        "rdm"          : {"anyof": ["rd", "m"]},
        "label"        : {"category": "label"},

        "1"            : {"category": "constant", "type": "INTEGER", "value": 1},
        "3"            : {"category": "constant", "type": "INTEGER", "value": 3},
        "a"            : {"location": "a"},
        "al"           : {"location": "a", "size": 1},
        "ax"           : {"location": "a", "size": 2},
        "eax"          : {"location": "a", "size": 4},
        "rax"          : {"location": "a", "size": 8},
        "cl"           : {"location": "c", "size": 1},
        "xmm0"         : {"location": "mm0"},
        "rel8"         : {"category": "label"},
        "rel32"        : {"category": "label"},
        "rel32m"       : {"category": "label"},
        "imm4"         : {"category": "constant", "type": "INTEGER", "value_bits": 4},
        "imm8"         : {"category": "constant", "type": "INTEGER", "value_bits": 8},
        "imm16"        : {"category": "constant", "type": "INTEGER", "value_bits": 16},
        "imm32"        : {"category": "constant", "type": "INTEGER", "value_bits": 32},
        "imm64"        : {"category": "constant", "type": "INTEGER", "value_bits": 64},
        "r8"           : {"anyof": "r", "size": 1},
        "r16"          : {"anyof": "r", "size": 2},
        "r32"          : {"anyof": "r", "size": 4},
        "r64"          : {"anyof": "r", "size": 8},
        "rd8"          : {"anyof": "rd", "size": 1},
        "rd16"         : {"anyof": "rd", "size": 2},
        "rd32"         : {"anyof": "rd", "size": 4},
        "rd64"         : {"anyof": "rd", "size": 8},
        "mm"           : false,
        "xmm"          : false,
        "xmm{k}"       : false,
        "xmm{k}{z}"    : false,
        "ymm"          : false,
        "ymm{k}"       : false,
        "ymm{k}{z}"    : false,
        "zmm"          : false,
        "zmm{k}"       : false,
        "zmm{k}{z}"    : false,
        "k"            : false,
        "k{k}"         : false,
        "m8"           : {"anyof": "m", "size": 1},
        "m16"          : {"anyof": "m", "size": 2},
        "m16{k}"       : false,
        "m32"          : {"anyof": "m", "size": 4},
        "m32{k}"       : false,
        "m64"          : {"anyof": "m", "size": 8},
        "m64{k}"       : false,
        "m80"          : false,
        "m128"         : false,
        "m128{k}"      : false,
        "m256"         : false,
        "m256{k}"      : false,
        "m512"         : false,
        "m512{k}"      : false,
        "moffs32"      : false,
        "moffs64"      : false,
        "m32/m16bcst"  : false,
        "m64/m16bcst"  : false,
        "m64/m32bcst"  : false,
        "m128/m16bcst" : false,
        "m128/m32bcst" : false,
        "m128/m64bcst" : false,
        "m256/m16bcst" : false,
        "m256/m32bcst" : false,
        "m256/m64bcst" : false,
        "m512/m16bcst" : false,
        "m512/m32bcst" : false,
        "m512/m64bcst" : false,
        "vm32x"        : false,
        "vm32x{k}"     : false,
        "vm32y"        : false,
        "vm32y{k}"     : false,
        "vm32z"        : false,
        "vm32z{k}"     : false,
        "vm64x"        : false,
        "vm64x{k}"     : false,
        "vm64y"        : false,
        "vm64y{k}"     : false,
        "vm64z"        : false,
        "vm64z{k}"     : false,
        "{sae}"        : false,
        "{er}"         : false
    },

    "no_reuse":  {"anyof": "m"},
    "no_output": {"category": ["label", "constant"]},

    "transfers": ["MOV"],

    "ir": {
        "MARKER":         {"input": [], "output": true,                 "translate": false},
        "BLOCK":          {"input": [], "output": false, "block": true, "translate": false},
        "FUNCTION":       {"input": [], "output": false, "block": true, "translate": false},

        "CALL_FUNCTION":  {"input": "any", "output": true,  "translate": "custom"},
        "CALL_PROCEDURE": {"input": "any", "output": false, "translate": "custom"},

        "JUMP":           {"input": ["target"],              "output": false},
        "JUMP_IF_TRUE":   {"input": ["target", "predicate"], "output": false},
        "JUMP_IF_FALSE":  {"input": ["target", "predicate"], "output": false},
        "RETURN_VAL":     {"input": ["value"],               "output": false},
        "RETURN":         {"input": [],                      "output": false},

        "COPY":           {"input": ["source"],              "output": true},
        "PLUS":           {"input": ["operand"],             "output": true},
        "MINUS":          {"input": ["operand"],             "output": true},
        "ADDRESSOF":      {"input": ["operand"],             "output": true},
        "FLOAT_TO_FLOAT": {"input": ["operand"],             "output": true},
        "INT_TO_FLOAT":   {"input": ["operand"],             "output": true},
        "FLOAT_TO_INT":   {"input": ["operand"],             "output": true},

        "MUL":            {"input": ["left", "right"],       "output": true},
        "DIV":            {"input": ["left", "right"],       "output": true},
        "MOD":            {"input": ["left", "right"],       "output": true},
        "ADD":            {"input": ["left", "right"],       "output": true},
        "SUB":            {"input": ["left", "right"],       "output": true},
        "LT":             {"input": ["left", "right"],       "output": true},
        "LE":             {"input": ["left", "right"],       "output": true},
        "GE":             {"input": ["left", "right"],       "output": true},
        "GT":             {"input": ["left", "right"],       "output": true},
        "EQ":             {"input": ["left", "right"],       "output": true},
        "NE":             {"input": ["left", "right"],       "output": true},
        "BITWISE_AND":    {"input": ["left", "right"],       "output": true},
        "BITWISE_XOR":    {"input": ["left", "right"],       "output": true},
        "BITWISE_OR":     {"input": ["left", "right"],       "output": true},
        "LSHIFT":         {"input": ["left", "right"],       "output": true},
        "RSHIFT":         {"input": ["left", "right"],       "output": true},
        "LOGICAL_AND":    {"input": ["left", "right"],       "output": true},
        "LOGICAL_OR":     {"input": ["left", "right"],       "output": true}
    },

    "translations": [
        // -------- ADD
        {"ir": {"tag": "ADD", "left": "rdm",  "right": "1" },  "target": {"instruction": "INC", "input": ["left"]}},
        {"ir": {"tag": "ADD", "left": "1",    "right": "rdm"}, "target": {"instruction": "INC", "input": ["right"]}},
        {"ir": {"tag": "ADD", "left": "rdm",  "right": "-1"},  "target": {"instruction": "DEC", "input": ["left"]}},
        {"ir": {"tag": "ADD", "left": "-1",   "right": "rdm"}, "target": {"instruction": "DEC", "input": ["right"]}},
        {"ir": {"tag": "ADD"},                               "target": {"instruction": "ADD"}},

        // -------- SUB
        {"ir": {"tag": "SUB", "left": "rdm",  "right":  "1"}, "target": {"instruction": "DEC", "input": ["left"]}},
        {"ir": {"tag": "SUB", "left": "rdm",  "right": "-1"}, "target": {"instruction": "INC", "input": ["left"]}},
        {"ir": {"tag": "SUB"},                                "target": {"instruction": "SUB"}},

        // -------- COPY
        {"ir": {"tag": "COPY"},                              "target": {"instruction": "MOV"}},

        // -------- Unconditional JUMP
        {"ir": {"tag": "JUMP", "target": "label"},           "target": {"instruction": "JMP"}},

        // -------- JUMP_IF_TRUE
        {"ir"    : [{"tag": "EQ",           "left": "int", "right": "int", "output": "tempbool"},
                    {"tag": "JUMP_IF_TRUE", "target": "label", "predicate": "$0.output"}],
         "target": [{"instruction": "CMP",  "input": ["$0.left", "$0.right"]},
                    {"instruction": "JE",   "input": ["$1.target"]}]},

        // -------- RETURN_VAL
        {"ir":       {"tag": "RETURN_VAL", "value": "constint"},
         "allocate": {"return_register": {"location": "a"}, "saved_stack": {"location": "bp", "size": 8}},
         "target":  [{"instruction": "MOV", "input": ["value"], "output": "$return_register"},
                     {"instruction": "POP", "output": "$saved_stack"},
                     {"instruction": "RET", "input": []}]},

        {"ir":       {"tag": "RETURN_VAL", "value": "a"},
         "allocate": {"saved_stack": {"location": "bp", "size": 8}},
         "target":  [{"instruction": "POP", "output": "$saved_stack"},
                     {"instruction": "RET", "input": []}]},

        // -------- RETURN
        {"ir":       {"tag": "RETURN"},
         "allocate": {"saved_stack": {"location": "bp", "size": 8}},
         "target":  [{"instruction": "POP", "output": "$saved_stack"},
                     {"instruction": "RET", "input": []}]},
    ]
}
