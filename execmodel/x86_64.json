{
    "locations": ["constant",
                  "a", "b", "c", "d", "si", "di", "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15",
                  "mm0", "mm1", "mm2", "mm3", "mm4", "mm5", "mm6", "mm7", "mm8", "mm9", "mm10", "mm11", "mm12", "mm13", "mm14", "mm15",
                  "stack", "memory",
                  "sp", "bp"],

    "operand_types": {
        "-1"           : {"category": "constant", "type": "INTEGER", "value": -1},
        "constint"     : {"category": "constant", "type": "INTEGER"},
        "int"          : {"type": "INTEGER"},
        "bool"         : {"type": "BOOLEAN"},
        "tempbool"     : {"type": "BOOLEAN", "storage": "TEMPORARY"},
        "r"            : {"location": ["a", "b", "c", "d", "si", "di", "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15"]},
        "m"            : {"union": [{"category": "dereference"}, {"location": ["stack", "memory"]}]},
        "rm"           : {"anyof": ["r", "m"]},
        "@"            : true,

        "1"            : {"category": "constant", "type": "INTEGER", "value":  1},
        "3"            : {"category": "constant", "type": "INTEGER", "value":  3},
        "a"            : {"location": "a"},
        "al"           : {"location": "a", "size": 1},
        "ax"           : {"location": "a", "size": 2},
        "eax"          : {"location": "a", "size": 4},
        "rax"          : {"location": "a", "size": 8},
        "cl"           : {"location": "c", "size": 1},
        "xmm0"         : {"location": "mm0"},
        "rel8"         : {"category": "label"},
        "rel32"        : {"category": "label"},
        "rel32m"       : {"category": "label"},
        "imm4"         : {"category": "constant", "type": "INTEGER", "value_bits": 4},
        "imm8"         : {"category": "constant", "type": "INTEGER", "value_bits": 8},
        "imm16"        : {"category": "constant", "type": "INTEGER", "value_bits": 16},
        "imm32"        : {"category": "constant", "type": "INTEGER", "value_bits": 32},
        "imm64"        : {"category": "constant", "type": "INTEGER", "value_bits": 64},
        "r8"           : {"anyof": "r", "size": 1},
        "r16"          : {"anyof": "r", "size": 2},
        "r32"          : {"anyof": "r", "size": 4},
        "r64"          : {"anyof": "r", "size": 8},
        "mm"           : false,
        "xmm"          : false,
        "xmm{k}"       : false,
        "xmm{k}{z}"    : false,
        "ymm"          : false,
        "ymm{k}"       : false,
        "ymm{k}{z}"    : false,
        "zmm"          : false,
        "zmm{k}"       : false,
        "zmm{k}{z}"    : false,
        "k"            : false,
        "k{k}"         : false,
        "m8"           : {"anyof": "m", "size": 1},
        "m16"          : {"anyof": "m", "size": 2},
        "m16{k}"       : false,
        "m32"          : {"anyof": "m", "size": 4},
        "m32{k}"       : false,
        "m64"          : {"anyof": "m", "size": 8},
        "m64{k}"       : false,
        "m80"          : false,
        "m128"         : false,
        "m128{k}"      : false,
        "m256"         : false,
        "m256{k}"      : false,
        "m512"         : false,
        "m512{k}"      : false,
        "moffs32"      : false,
        "moffs64"      : false,
        "m32/m16bcst"  : false,
        "m64/m16bcst"  : false,
        "m64/m32bcst"  : false,
        "m128/m16bcst" : false,
        "m128/m32bcst" : false,
        "m128/m64bcst" : false,
        "m256/m16bcst" : false,
        "m256/m32bcst" : false,
        "m256/m64bcst" : false,
        "m512/m16bcst" : false,
        "m512/m32bcst" : false,
        "m512/m64bcst" : false,
        "vm32x"        : false,
        "vm32x{k}"     : false,
        "vm32y"        : false,
        "vm32y{k}"     : false,
        "vm32z"        : false,
        "vm32z{k}"     : false,
        "vm64x"        : false,
        "vm64x{k}"     : false,
        "vm64y"        : false,
        "vm64y{k}"     : false,
        "vm64z"        : false,
        "vm64z{k}"     : false,
        "{sae}"        : false,
        "{er}"         : false
    },

    "no_reuse":  {"anyof": "m"},
    "no_output": {"category": ["label", "constant"]},

    "transfers": [
        {"input": "constint:0", "output": "r:1", "target": "MOV"},
        {"input": "r:0",        "output": "r:1", "target": "MOV"},
        {"input": "r:0",        "output": "m:1", "target": "MOV"},
        {"input": "m:0",        "output": "r:1", "target": "MOV"}
    ],

    "translations": [
        {"ir": {"tag": "ADD", "input": [ "rm:0",   "1:1"]},             "target": {"instruction": "INC", "input": [0]}},
        {"ir": {"tag": "ADD", "input": [  "1:0",  "rm:1"]},             "target": {"instruction": "INC", "input": [1]}},
        {"ir": {"tag": "ADD", "input": [ "rm:0",  "-1:1"]},             "target": {"instruction": "DEC", "input": [0]}},
        {"ir": {"tag": "ADD", "input": [ "-1:0",  "rm:1"]},             "target": {"instruction": "DEC", "input": [1]}},
        {"ir": {"tag": "ADD", "input": ["int:0", "int:1"]},             "target": {"instruction": "ADD", "input": [0, 1]}},

        {"ir": {"tag": "SUB", "input": [ "rm:0",   "1:1"]},             "target": {"instruction": "DEC", "input": [0]}},
        {"ir": {"tag": "SUB", "input": [ "rm:0",  "-1:1"]},             "target": {"instruction": "INC", "input": [0]}},
        {"ir": {"tag": "SUB", "input": ["int:0", "int:1"]},             "target": {"instruction": "SUB", "input": [0, 1]}},

        {"ir": {"tag": "COPY", "input": ["int:0"], "output": ["int:1"]}, "target": {"instruction": "MOV", "input": [0], "output": [1]}},

        {"ir": {"tag": "JUMP", "input": ["label:0"]},                    "target": {"instruction": "JMP", "input": [0]}},

        {"ir"    : [{"tag": "EQ",           "input": ["int:0", "int:1"], "output": ["tempbool:2"]},
                    {"tag": "JUMP_IF_TRUE", "input": ["label:3", 2]}],
         "target": [{"instruction": "CMP",  "input": [0, 1]},
                    {"instruction": "JE",   "input": [3]}]},

        {"ir": {"tag": "RETURN", "input": ["a:0"]},                        "target": {"instruction": "RET", "input": []}},
        {"ir": {"tag": "RETURN", "input": []},                             "target": {"instruction": "RET"}}
    ]
}
