{
    "locations": ["constant",
                  "a", "b", "c", "d", "si", "di", "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15",
                  "mm0", "mm1", "mm2", "mm3", "mm4", "mm5", "mm6", "mm7", "mm8", "mm9", "mm10", "mm11", "mm12", "mm13", "mm14", "mm15",
                  "stack", "memory",
                  "sp", "bp"],

    "operandtypes": {
        "-1"           : {"category": "constant", "type": "INTEGER", "value": -1},
        "constint"     : {"category": "constant", "type": "INTEGER"},
        "r"            : {"location": ["a", "b", "c", "d", "si", "di", "sp", "bp", "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15"]},
        "m"            : {"union": [{"category": "dereference"}, {"location": ["stack"]}]},
        "rm"           : {"anyof": ["r", "m"]},

        "1"            : {"category": "constant", "type": "INTEGER", "value":  1},
        "3"            : {"category": "constant", "type": "INTEGER", "value":  3},
        "a"            : {"location": ["a"]},
        "al"           : {"location": ["a"],    "size": 1},
        "ax"           : {"location": ["a"],    "size": 2},
        "eax"          : {"location": ["a"],    "size": 4},
        "rax"          : {"location": ["a"],    "size": 8},
        "cl"           : {"location": ["c"],    "size": 1},
        "xmm0"         : {"location": ["mm0"]},
        "rel8"         : {"category": "label"},
        "rel32"        : {"category": "label"},
        "rel32m"       : {"category": "label"},
        "imm4"         : {"category": "constant", "type": "INTEGER", "value_bits": 4},
        "imm8"         : {"category": "constant", "type": "INTEGER", "value_bits": 8},
        "imm16"        : {"category": "constant", "type": "INTEGER", "value_bits": 16},
        "imm32"        : {"category": "constant", "type": "INTEGER", "value_bits": 32},
        "imm64"        : {"category": "constant", "type": "INTEGER", "value_bits": 64},
        "r8"           : {"anyof": ["r"], "size": 1},
        "r16"          : {"anyof": ["r"], "size": 2},
        "r32"          : {"anyof": ["r"], "size": 4},
        "r64"          : {"anyof": ["r"], "size": 8},
        "mm"           : false,
        "xmm"          : false,
        "xmm{k}"       : false,
        "xmm{k}{z}"    : false,
        "ymm"          : false,
        "ymm{k}"       : false,
        "ymm{k}{z}"    : false,
        "zmm"          : false,
        "zmm{k}"       : false,
        "zmm{k}{z}"    : false,
        "k"            : false,
        "k{k}"         : false,
        "m8"           : {"anyof": ["m"], "size": 1},
        "m16"          : {"anyof": ["m"], "size": 2},
        "m16{k}"       : false,
        "m32"          : {"anyof": ["m"], "size": 4},
        "m32{k}"       : false,
        "m64"          : {"anyof": ["m"], "size": 8},
        "m64{k}"       : false,
        "m80"          : false,
        "m128"         : false,
        "m128{k}"      : false,
        "m256"         : false,
        "m256{k}"      : false,
        "m512"         : false,
        "m512{k}"      : false,
        "moffs32"      : false,
        "moffs64"      : false,
        "m32/m16bcst"  : false,
        "m64/m16bcst"  : false,
        "m64/m32bcst"  : false,
        "m128/m16bcst" : false,
        "m128/m32bcst" : false,
        "m128/m64bcst" : false,
        "m256/m16bcst" : false,
        "m256/m32bcst" : false,
        "m256/m64bcst" : false,
        "m512/m16bcst" : false,
        "m512/m32bcst" : false,
        "m512/m64bcst" : false,
        "vm32x"        : false,
        "vm32x{k}"     : false,
        "vm32y"        : false,
        "vm32y{k}"     : false,
        "vm32z"        : false,
        "vm32z{k}"     : false,
        "vm64x"        : false,
        "vm64x{k}"     : false,
        "vm64y"        : false,
        "vm64y{k}"     : false,
        "vm64z"        : false,
        "vm64z{k}"     : false,
        "{sae}"        : false,
        "{er}"         : false
    },

    "transfers": [
        {"input": "constint:0", "output": "r:1", "target": "MOV"},
        {"input": "r:0",        "output": "r:1", "target": "MOV"},
        {"input": "r:0",        "output": "m:1", "target": "MOV"},
        {"input": "m:0",        "output": "r:1", "target": "MOV"}
    ],

    "translations": {
        "ADD"   : [{"name": "inc", "commutative": true, "input": ["rm:0",  "1:"], "target": "INC"},
                   {"name": "dec", "commutative": true, "input": ["rm:0", "-1:"], "target": "DEC"},
                   {"name": "add",                                                "target": "ADD"}],
        "SUB"   : [{"name": "dec",                      "input": ["rm:0", " 1:"], "target": "DEC"},
                   {"name": "inc",                      "input": ["rm:0", "-1:"], "target": "INC"},
                   {"name": "sub",                                                "target": "SUB"}],
        "COPY"  : [{                                                              "target": "MOV"}],
        "JUMP"  : [{                                                              "target": "JMP"}],
        "RETURN": [{"name": "with_value",               "input": ["a:"],          "target": "RET"},
                   {"name": "without_value",            "input": [],              "target": "RET"}]
    }
}
